<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps IPTV cleartext streams working, but pins trust to system CAs only:
     user/client-certificate MITM is rejected (security hardening). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
